# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ALPACA_API_KEY=
ALPACA_API_SECRET=
ANTHROPIC_API_KEY=

# Pinned scoring model. Changing it means re-scoring and re-auditing.
LLM_MODEL=claude-haiku-5-5
LLM_PROMPT_VERSION=p1
# Set to the pinned model's published training-data cutoff. Replays only use news AFTER it.
LLM_KNOWLEDGE_CUTOFF=2026-07-01

# iex is free; sip (full market volume) needs a paid Alpaca data plan.
ALPACA_DATA_FEED=iex

# paper (default) or live. Live also requires LIVE_CONFIRM and every audit gate passing.
TRADING_MODE=paper
LIVE_CONFIRM=
